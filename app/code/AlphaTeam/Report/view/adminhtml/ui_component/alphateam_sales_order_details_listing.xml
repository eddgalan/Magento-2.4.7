<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd"
         name="alphateam_sales_order_details_listing">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">alphateam_sales_order_details_listing.alphateam_report_listing_data_source</item>
            <item name="deps" xsi:type="string">alphateam_sales_order_details_listing.alphateam_report_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>alphateam_sales_order_details_listing_columns</spinner>
        <deps>
            <dep>alphateam_sales_order_details_listing.alphateam_report_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="alphateam_report_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">entity_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>AlphaTeam_Report::SalesOrderDetails</aclResource>
        <dataProvider class="AlphaTeam\Report\Ui\DataProvider\SalesOrderDetailsDataProvider"
                      name="alphateam_report_listing_data_source">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
        <exportButton name="export_button"/>
    </listingToolbar>
    <columns name="alphateam_sales_order_details_listing_columns">
        <selectionsColumn name="ids">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="indexField" xsi:type="string">entity_id</item>
                </item>
            </argument>
        </selectionsColumn>
        <column name="entity_id" sortOrder="10">
            <settings>
                <label translate="true">Order ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>

        <column name="increment_id" sortOrder="20">
            <settings>
                <label translate="true">Order #</label>
            </settings>
        </column>

        <column name="state" sortOrder="30">
            <settings>
                <label translate="true">State</label>
            </settings>
        </column>

        <column name="status" sortOrder="40">
            <settings>
                <label translate="true">Status</label>
            </settings>
        </column>

        <column name="customer_email" sortOrder="50">
            <settings>
                <label translate="true">Customer Email</label>
            </settings>
        </column>

        <column name="subtotal" sortOrder="60">
            <settings>
                <label translate="true">Subtotal</label>
                <filter>textRange</filter>
            </settings>
        </column>

        <column name="discount_amount" sortOrder="70">
            <settings>
                <label translate="true">Order Discount</label>
                <filter>textRange</filter>
            </settings>
        </column>

        <column name="coupon_code" sortOrder="80">
            <settings>
                <label translate="true">Coupon Code</label>
            </settings>
        </column>

        <column name="shipping_amount" sortOrder="90">
            <settings>
                <label translate="true">Shipping</label>
                <filter>textRange</filter>
            </settings>
        </column>

        <column name="tax_amount" sortOrder="100">
            <settings>
                <label translate="true">Tax</label>
                <filter>textRange</filter>
            </settings>
        </column>

        <column name="grand_total" sortOrder="110">
            <settings>
                <label translate="true">Grand Total</label>
                <filter>textRange</filter>
            </settings>
        </column>

        <column name="total_paid" sortOrder="120">
            <settings>
                <label translate="true">Total Paid</label>
                <filter>textRange</filter>
            </settings>
        </column>

        <column name="total_refunded" sortOrder="130">
            <settings>
                <label translate="true">Total Refunded</label>
                <filter>textRange</filter>
            </settings>
        </column>

        <!-- Campos de item -->
        <column name="sku" sortOrder="140">
            <settings>
                <label translate="true">SKU</label>
            </settings>
        </column>

        <column name="name" sortOrder="150">
            <settings>
                <label translate="true">Product Name</label>
            </settings>
        </column>

        <column name="product_type" sortOrder="160">
            <settings>
                <label translate="true">Product Type</label>
            </settings>
        </column>

        <column name="base_price" sortOrder="170">
            <settings>
                <label translate="true">Base Price</label>
                <filter>textRange</filter>
            </settings>
        </column>

        <column name="item_discount_amount" sortOrder="180">
            <settings>
                <label translate="true">Item Discount</label>
                <filter>textRange</filter>
            </settings>
        </column>

        <column name="qty_ordered" sortOrder="190">
            <settings>
                <label translate="true">Qty Ordered</label>
                <filter>textRange</filter>
            </settings>
        </column>

        <column name="qty_invoiced" sortOrder="200">
            <settings>
                <label translate="true">Qty Invoiced</label>
                <filter>textRange</filter>
            </settings>
        </column>

        <column name="qty_shipped" sortOrder="210">
            <settings>
                <label translate="true">Qty Shipped</label>
                <filter>textRange</filter>
            </settings>
        </column>

        <column name="qty_refunded" sortOrder="220">
            <settings>
                <label translate="true">Qty Refunded</label>
                <filter>textRange</filter>
            </settings>
        </column>

        <!-- Pago -->
        <column name="payment_method" sortOrder="230">
            <settings>
                <label translate="true">Payment Method</label>
            </settings>
        </column>

        <column name="created_at" sortOrder="240" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <label translate="true">Created At</label>
                <filter>dateRange</filter>
            </settings>
        </column>
    </columns>
</listing>
